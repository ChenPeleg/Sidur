{
    "name": "Sidur",
    "version": "0.2.0",
    "private": true,
    "homepage": "https://chenpeleg.github.io/Sidur",
    "homepage-gh-pages": "https://chenpeleg.github.io/Sidur",
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "vite",
        "start": "vite",
        "build": "tsc && vite build",
        "typecheck": "tsc",
        "build:gh-pages": "tsc && vite build --mode production-github",
        "build:site": "tsc && vite build --mode production-firebase",
        "build:prod": "tsc && vite build --mode production-firebase",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "predeploy": "npm run build:gh-pages",
        "deploy": "gh-pages -d build",
        "format": "prettier --write .",
        "lint": "eslint ."
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.5.0",
        "@mui/lab": "^9.0.0-beta.10",
        "@mui/material": "^9.5.0",
        "@mui/x-date-pickers": "^9.16.0",
        "@redux-devtools/extension": "^4.0.0",
        "@reduxjs/toolkit": "^2.13.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-redux": "^9.3.0",
        "react-router": "^8.5.0",
        "typescript": "~6.0.3"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react": "^7.37.5",
        "gh-pages": "^6.3.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}
